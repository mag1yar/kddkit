{
  "name": "kddkit-monorepo",
  "private": true,
  "description": "KDD — kanban + memory substrate for humans and coding agents.",
  "author": {
    "name": "kddkit",
    "url": "https://github.com/mag1yar"
  },
  "license": "MIT",
  "homepage": "https://github.com/mag1yar/kddkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mag1yar/kddkit.git"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "bumpp": "^11.1.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "turbo run build && node scripts/sync-codex-plugin.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:codex-plugin": "node scripts/test-codex-plugin.mjs",
    "dev:cli": "KDD_HOME=$HOME/.kdd-dev node packages/cli/dist/index.js",
    "dev:ui": "KDD_HOME=$HOME/.kdd-dev node packages/cli/dist/index.js ui --port 4488",
    "release": "bumpp package.json packages/*/package.json .claude-plugin/plugin.json integrations/codex-plugin/.codex-plugin/plugin.json --all --no-push --execute \"pnpm build && pnpm test && pnpm typecheck && pnpm test:codex-plugin\" && npx -y changelogithub@14 --dry",
    "release:publish": "pnpm -r publish && git push --follow-tags",
    "release:next": "node scripts/release-next.mjs",
    "release:next:publish": "node scripts/publish-next.mjs"
  }
}
